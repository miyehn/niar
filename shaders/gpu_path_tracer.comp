#version 460 core
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#include "scene_common.glsl"
#include "sky_common.glsl"
#include "utils.glsl"
#include "cshared/lights.h"

// (set 0, binding 0) is view info from scene_common.glsl
layout(set = DSET_FRAMEGLOBAL, binding = 1) uniform accelerationStructureEXT SceneTLAS;
layout(set = DSET_FRAMEGLOBAL, binding = 2, rgba8) uniform writeonly image2D OutputImage;
layout(set = DSET_FRAMEGLOBAL, binding = 3, std430) readonly buffer SceneInstanceRecordTable {
    GpuSceneInstanceRecord SceneInstanceRecords[];
};
#define SCENE_INSTANCE_RECORDS_AVAILABLE 1 // see rt_common.glsl
layout(set = DSET_FRAMEGLOBAL, binding = 4) uniform PointLightsInfo {
    PointLightInfo Data[MAX_LIGHTS_PER_PASS];
} PointLights;
layout(set = DSET_FRAMEGLOBAL, binding = 5) uniform DirectionalLightsInfo {
    DirectionalLightInfo Data[MAX_LIGHTS_PER_PASS];
} DirectionalLights;
layout(set = DSET_FRAMEGLOBAL, binding = 6) uniform sampler2D EnvironmentMap;
layout(set = DSET_FRAMEGLOBAL, binding = 7, rgba32f) uniform image2D AccumulationImage;

// (set 1, binding 0) sky parameters
// (set 1, binding 8) transmittance
// (set 1, binding 9) skyview

#include "lighting_common.glsl"

layout(push_constant) uniform GpuPathTracerPushConstants {
    uint MaxRayDepth;
    uint SampleCount; // samples per pixel accumulated before this dispatch
    uint MaxSpp;      // once SampleCount reaches this, nothing is traced anymore
} Push;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// helpers for sampling

// Cosine-weighted
void CosineWeightedSampler_Sample(vec3 surfaceNormal, vec2 u, out vec3 wi, out float pdf)
{
    wi = sampleCosineWeightedHemisphere(surfaceNormal, u);
    pdf = max(dot(surfaceNormal, wi), 0.0) / PI;
}

// the BRDF of a Lambertian surface, without the cosine term
vec3 CosineWeightedSampler_Evaluate(vec3 surfaceNormal, vec3 albedo, vec3 wo, vec3 wi)
{
    return albedo / PI;
}

// radiance arriving along a ray, from a path of up to maxRayDepth rays (this one included) that bounces off surfaces.
// Light only comes from emissive surfaces and the background; point and directional lights don't contribute.
vec3 tracePath(accelerationStructureEXT tlas, vec3 origin, vec3 dir, float whiteNoiseXYF, uint maxRayDepth)
{
    ViewInfo viewInfo = GetViewInfo();

    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    // every ray of the path gets noise of its own, which keeps the rays' alpha decisions independent of each other
    for (uint depth = 0u; depth < maxRayDepth; depth++)
    {
        float whiteNoiseXYFR = makeWhiteNoiseXYFR(whiteNoiseXYF, NOISE_KIND_PATH_RAY, depth);
        RayHitResult hit = traceClosestHit(tlas, origin, dir, whiteNoiseXYFR);
        if (hit.intersectionType == RAY_HIT_NONE) // miss
        {
            vec3 background = vec3(0.0);
            if (viewInfo.BackgroundOption == 1) {
                background = sampleLongLatMap(EnvironmentMap, dir, 0.0);
            } else if (viewInfo.BackgroundOption == 2) {
                background = sampleSkyAtmosphere(dir);
            }
            radiance += throughput * background;
            break;
        }

        HitSurface surface;
        if (!reconstructHitSurface(hit, SceneInstanceRecords[hit.instanceCustomIndex], origin, dir, surface)) break;

        // now able to get material information at hit
        SurfaceMaterial material = fetchSurfaceMaterial(surface);

        radiance += throughput * material.emission;

        // noise for choosing the next direction, one pair per bounce
        vec2 whiteNoiseXYFB = vec2(
            white_noise01(uvec3(depth, NOISE_KIND_NEXT_DIRECTION, 0u), whiteNoiseXYF),
            white_noise01(uvec3(depth, NOISE_KIND_NEXT_DIRECTION, 1u), whiteNoiseXYF));
        vec3 wi;
        float pdf;
        CosineWeightedSampler_Sample(surface.worldNormal, whiteNoiseXYFB, wi, pdf);
        if (pdf <= 0.0) break;

        vec3 f = CosineWeightedSampler_Evaluate(surface.worldNormal, material.albedo, surface.outgoingDirection, wi);
        throughput *= f * dot(surface.worldNormal, wi) / pdf; // don't simplify even for just diffuse, to keep it generalized

        origin = surface.worldPosition + surface.worldNormal * 0.001;
        dir = wi;
    }

    return radiance;
}

// same curve as post_processing.frag
float reinhard2(float x)
{
    const float L_white = 2.0;
    return (x * (1.0 + x / (L_white * L_white))) / (1.0 + x);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(OutputImage);
    if (any(greaterThanEqual(pixel, dims))) {
        return;
    }

    ViewInfo viewInfo = GetViewInfo();

    vec3 accumulated;
    if (Push.SampleCount < Push.MaxSpp) {
        // primary ray through the pixel center, in the same convention as ray_gen.rgen
        vec2 ndc = (vec2(pixel) + 0.5) / vec2(dims) * 2.0 - 1.0;
        float halfFovY = tan(viewInfo.HalfVFovRadians);
        vec3 rayDirView = vec3(ndc.x * halfFovY * viewInfo.AspectRatio, -ndc.y * halfFovY, -1.0);
        vec3 rayDir = normalize(transpose(mat3(viewInfo.ViewMatrix)) * rayDirView);

        // shared by all the rays of this pixel's path, which derive noise of their own from it
        float whiteNoiseXYF = white_noise01(uvec2(pixel), viewInfo.WhiteNoiseF.x);

        vec3 radiance = tracePath(SceneTLAS, viewInfo.CameraPosition, rayDir, whiteNoiseXYF, Push.MaxRayDepth);

        // a NaN or infinite sample would never leave the average
        if (any(isnan(radiance)) || any(isinf(radiance))) {
            radiance = vec3(0.0);
        }

        // running average of all the samples of this pixel so far. The first sample doesn't read what is there: it is
        // stale, or not even initialized yet, and a NaN in it would survive being multiplied by 0
        if (Push.SampleCount == 0u) {
            accumulated = radiance;
        } else {
            accumulated = mix(imageLoad(AccumulationImage, pixel).rgb, radiance, 1.0 / float(Push.SampleCount + 1u));
        }
        imageStore(AccumulationImage, pixel, vec4(accumulated, 1.0));
    } else {
        // every pixel has all its samples: only show the average, with the current exposure
        accumulated = imageLoad(AccumulationImage, pixel).rgb;
    }

    // exposure and tone mapping, as in post_processing.frag
    vec3 exposed = accumulated * pow(2.0, viewInfo.Exposure);
    vec3 color = vec3(reinhard2(exposed.r), reinhard2(exposed.g), reinhard2(exposed.b));
    imageStore(OutputImage, pixel, vec4(color, 1.0));
}
