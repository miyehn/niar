#version 460 core
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#include "scene_common.glsl"
#include "sky_common.glsl"
#include "utils.glsl"
#include "cshared/lights.h"

// (set 0, binding 0) is view info from scene_common.glsl
layout(set = DSET_FRAMEGLOBAL, binding = 1) uniform accelerationStructureEXT SceneTLAS;
layout(set = DSET_FRAMEGLOBAL, binding = 2, rgba8) uniform writeonly image2D OutputImage;
layout(set = DSET_FRAMEGLOBAL, binding = 3, std430) readonly buffer SceneInstanceRecordTable {
    GpuSceneInstanceRecord SceneInstanceRecords[];
};
#define SCENE_INSTANCE_RECORDS_AVAILABLE 1 // see rt_common.glsl
layout(set = DSET_FRAMEGLOBAL, binding = 4) uniform PointLightsInfo {
    PointLightInfo Data[MAX_LIGHTS_PER_PASS];
} PointLights;
layout(set = DSET_FRAMEGLOBAL, binding = 5) uniform DirectionalLightsInfo {
    DirectionalLightInfo Data[MAX_LIGHTS_PER_PASS];
} DirectionalLights;
layout(set = DSET_FRAMEGLOBAL, binding = 6) uniform sampler2D EnvironmentMap;

// (set 1, binding 0) sky parameters
// (set 1, binding 8) transmittance
// (set 1, binding 9) skyview

#include "lighting_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// same curve as post_processing.frag
float reinhard2(float x)
{
    const float L_white = 2.0;
    return (x * (1.0 + x / (L_white * L_white))) / (1.0 + x);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(OutputImage);
    if (any(greaterThanEqual(pixel, dims))) {
        return;
    }

    ViewInfo viewInfo = GetViewInfo();

    // primary ray through the pixel center, in the same convention as ray_gen.rgen
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(dims) * 2.0 - 1.0;
    float halfFovY = tan(viewInfo.HalfVFovRadians);
    vec3 rayDirView = vec3(ndc.x * halfFovY * viewInfo.AspectRatio, -ndc.y * halfFovY, -1.0);
    vec3 rayDir = normalize(transpose(mat3(viewInfo.ViewMatrix)) * rayDirView);

    // shared by the primary ray and the shadow rays, which tell themselves apart by ray id
    float noise = white_noise01(uvec3(uvec2(pixel), viewInfo.FrameIndex), viewInfo.FrameRandom.x);

    RayHitResult hitResult = traceClosestHit(SceneTLAS, viewInfo.CameraPosition, rayDir, noise);

    vec3 radiance = vec3(0.0);
    if (hitResult.intersectionType != RAY_HIT_NONE) {
        GpuSceneInstanceRecord sceneInstance = SceneInstanceRecords[hitResult.instanceCustomIndex];
        HitSurface surface;
        if (reconstructHitSurface(hitResult, sceneInstance, viewInfo.CameraPosition, rayDir, surface)) {
            radiance = shadeSurface(SceneTLAS, surface, noise);
        } else {
            radiance = vec3(1.0, 0.0, 1.0); // invalid hit
        }
    } else if (viewInfo.BackgroundOption == 1) {
        radiance = sampleLongLatMap(EnvironmentMap, rayDir, 0.0);
    } else if (viewInfo.BackgroundOption == 2) {
        radiance = sampleSkyAtmosphere(rayDir);
    }

    // exposure and tone mapping, as in post_processing.frag
    vec3 exposed = radiance * pow(2.0, viewInfo.Exposure);
    vec3 color = vec3(reinhard2(exposed.r), reinhard2(exposed.g), reinhard2(exposed.b));
    imageStore(OutputImage, pixel, vec4(color, 1.0));
}
