#version 460
#extension GL_EXT_ray_tracing : require

#include "cshared/cshared_common.h"

layout(set = DSET_FRAMEGLOBAL, binding = 0) uniform ViewInfoUBO
{
	ViewInfo data;
}
_ViewInfo;

layout(set = DSET_FRAMEGLOBAL, binding = 1) uniform accelerationStructureEXT Scene;
layout(set = DSET_FRAMEGLOBAL, binding = 2, rgba8) uniform image2D ResultImage;

layout(location = 0) rayPayloadEXT vec3 ResultColor;

void main() {
	ViewInfo viewInfo = _ViewInfo.data;

	// Pixel center in NDC [-1, 1]
	const vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
	const vec2 inUV = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
	const vec2 ndc = inUV * 2.0 - 1.0;

	// Ray direction in view space
	float halfFovY = tan(viewInfo.HalfVFovRadians);
	vec3 rayDir_view = vec3(ndc.x * halfFovY * viewInfo.AspectRatio, -ndc.y * halfFovY, -1.0);

	// Transform to world space: camera-to-world rotation = transpose of upper-left 3x3 of ViewMatrix
	mat3 camToWorld = transpose(mat3(viewInfo.ViewMatrix));
	vec3 direction = normalize(camToWorld * rayDir_view);

	traceRayEXT(
		Scene,
		gl_RayFlagsNoneEXT,
		0xFF,    // cullMask
		0,       // sbtRecordOffset TRYME looks like this is added to .instanceShaderBindingTableRecordOffset in cpp
		0,       // sbtRecordStride
		0,       // missIndex tryme!
		viewInfo.CameraPosition,
		0.001f,
		direction,
		10000.0f,
		0);      // payload location

	imageStore(ResultImage, ivec2(gl_LaunchIDEXT.xy), vec4(ResultColor, 1.0f));
}