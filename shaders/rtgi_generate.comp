#version 460 core
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#include "rt_common.glsl"
#include "scene_common.glsl"
#include "sky_common.glsl"
#include "bindless_resources.glsl"
#include "cshared/lights.h"

// (set 0, binding 0) is view info from scene_common.glsl
layout(set = 0, binding = 1) uniform sampler2D SceneDepth;
layout(set = 0, binding = 2) uniform sampler2D GNormal;
layout(set = 0, binding = 3) uniform sampler2D MotionVectors;
layout(set = 0, binding = 4) uniform accelerationStructureEXT SceneTLAS;
layout(set = 0, binding = 5, rgba16f) uniform image2D IndirectLighting;
layout(set = 0, binding = 6) uniform sampler2D EnvironmentMap;
layout(set = 0, binding = 7, std430) readonly buffer SceneInstanceRecordTable {
    GpuSceneInstanceRecord SceneInstanceRecords[];
};
layout(set = 0, binding = 8) uniform RtgiPointLightsInfo {
    PointLightInfo Data[MAX_LIGHTS_PER_PASS];
} PointLights;
layout(set = 0, binding = 9) uniform RtgiDirectionalLightsInfo {
    DirectionalLightInfo Data[MAX_LIGHTS_PER_PASS];
} DirectionalLights;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D RtgiReadHistory;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D RtgiWriteHistory;
layout(set = 0, binding = 12, r32ui) uniform readonly uimage2D RtgiReadSampleCount;
layout(set = 0, binding = 13, r32ui) uniform writeonly uimage2D RtgiWriteSampleCount;

#include "lighting_common.glsl"

layout(push_constant) uniform RtgiPushConstants {
    uint MaxSampleCount;
    float HistoryDepthRejectionThreshold;
} Push;

// (set 1, binding 0) sky parameters
// (set 1, binding 8) transmittance
// (set 1, binding 9) skyview

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

vec3 sampleBackground(ViewInfo viewInfo, vec3 rayDir)
{
    if (viewInfo.BackgroundOption == 1) {
        return sampleLongLatMap(EnvironmentMap, rayDir, 0.0);
    }
    if (viewInfo.BackgroundOption == 2) {
        return sampleSkyAtmosphere(rayDir);
    }
    return vec3(0.0);
}

vec3 shadeInvalid()
{
    return vec3(1, 0, 1) * 0.05;
}


vec3 shadeCommittedHit(RayHitResult hitResult, vec3 rayOrigin, vec3 rayDir, float whiteNoise)
{
    if (hitResult.instanceCustomIndex == ~0u) {
        return shadeInvalid();
    }

    GpuSceneInstanceRecord sceneInstance = SceneInstanceRecords[hitResult.instanceCustomIndex];

    HitSurface surface;
    if (!reconstructHitSurface(hitResult, sceneInstance, rayOrigin, rayDir, surface)) {
        return shadeInvalid();
    }

    return shadeSurface(SceneTLAS, surface, whiteNoise);
}

// last frame's world-space surface point at a history texel, rebuilt from the linear depth stored in history alpha
// myn: whatever leave it for another time... or get rid of TAA some day to remove this mess :/
vec3 reconstructPrevWorldPosition(ivec2 prevPixel, float prevLinearDepth, ViewInfo viewInfo, vec2 dims)
{
    // the texel center, minus the jitter that was baked into last frame's projection
    vec2 ndc = (vec2(prevPixel) + 0.5 - viewInfo.PrevJitterOffset) / dims * 2.0 - 1.0;
    vec3 prevViewPos = vec3(
        ndc.x / viewInfo.PrevUnjitteredProjectionMatrix[0][0],
        ndc.y / viewInfo.PrevUnjitteredProjectionMatrix[1][1],
        -1.0) * prevLinearDepth;
    mat3 prevCameraToWorldRot = transpose(mat3(viewInfo.PrevViewMatrix));
    return prevCameraToWorldRot * (prevViewPos - viewInfo.PrevViewMatrix[3].xyz);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(IndirectLighting);
    if (pixel.x >= dims.x || pixel.y >= dims.y) {
        return;
    }

    float deviceDepth = texelFetch(SceneDepth, pixel, 0).r;
    vec3 normal = texelFetch(GNormal, pixel, 0).xyz;
    if (deviceDepth >= 1.0f) {
        // sky pixel: no surface; clear history so it doesn't bleed when geometry moves in
        imageStore(IndirectLighting, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(RtgiWriteHistory, pixel, vec4(0.0));
        imageStore(RtgiWriteSampleCount, pixel, uvec4(0u));
        return;
    }

    normal = normalize(normal);
    ViewInfo viewInfo = GetViewInfo();
    vec2 screenUv = (vec2(pixel) + 0.5f) / vec2(dims);
    vec3 worldPos = reconstructWorldPositionFromDepth(screenUv, deviceDepth, viewInfo); // affected by current frame jitter

    // linearized view-space depth, stored in history alpha for future rejection in chunk 5
    vec4 viewSpacePos = viewInfo.ViewMatrix * vec4(worldPos, 1.0);
    float linearDepth = -viewSpacePos.z; // affected by current frame jitter

    vec2 random = vec2(
        white_noise01(uvec3(uvec2(pixel), viewInfo.FrameIndex), viewInfo.FrameRandom.x),
        white_noise01(uvec3(uvec2(pixel.yx), viewInfo.FrameIndex), viewInfo.FrameRandom.y));
    vec3 rayDir = sampleCosineWeightedHemisphere(normal, random);
    vec3 rayOrigin = worldPos + normal * EPSILON;

    rayQueryEXT rq;
    rayQueryInitializeEXT(
        rq,
        SceneTLAS,
        // ray flags:
        0
        // | gl_RayFlagsTerminateOnFirstHitEXT // with this flag present, may terminate at ANY hit, not necessarily closest
        // | gl_RayFlagsSkipClosestHitShaderEXT // only relevant when in ray tracing pipeline
        // | gl_RayFlagsOpaqueEXT,
        ,
        0xFF, // cull mask, see: https://github.com/KhronosGroup/GLSL/blob/d2470a0a124bbb8c90a3576aca94694bd2f789e0/extensions/ext/GLSL_EXT_ray_query.txt#L286
              // basically, the 8 bits will be combined with the mask field in VkAccelerationStructureInstanceKHR. Visible if result is non-zero.
        rayOrigin,
        0.001,
        rayDir,
        10000.0);
    while (rayQueryProceedEXT(rq)) {
        if (candidateHitPassesAlpha(rq, random.x, NON_SHADOW_RAY_ID)) {
            rayQueryConfirmIntersectionEXT(rq);
        }
    }
    RayHitResult hitResult = interpretFinalRayQuery(rq);

    vec3 newSample = hitResult.intersectionType != RAY_HIT_NONE ? shadeCommittedHit(hitResult, rayOrigin, rayDir, random.x) : sampleBackground(viewInfo, rayDir);

    // per-pixel motion vector (currentUV - prevUV) produced by the motion vector pass, independent of jitter
    vec2 motionVector = texture(MotionVectors, screenUv).rg;
    vec2 prevUv = screenUv - motionVector; // where to read history data from, to compensate for camera motion.
    ivec2 prevPixel = ivec2(prevUv * vec2(dims));
    bool prevUvInBounds = all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0)));

    // Validate history by plane distance .Rebuild last frame's surface point from the stored depth along that texel's
    // (jittered) ray and measure its distance to this pixel's tangent plane, which is ~0 for the same static surface.
    float storedPrevDepth = prevUvInBounds ? imageLoad(RtgiReadHistory, prevPixel).a : 0.0; // last frame's linearDepth
    float planeDistance = 0.0;
    if (storedPrevDepth > 0.0) {
        vec3 prevWorldPos = reconstructPrevWorldPosition(prevPixel, storedPrevDepth, viewInfo, vec2(dims));
        planeDistance = abs(dot(normal, prevWorldPos - worldPos));
    }

    // RtgiRead/WriteSampleCount texels: sample count in the low 16 bits, reason history was rejected this frame in the high bits
#define SAMPLE_COUNT_MASK 0xFFFFu
#define REJECT_NONE 0u
#define REJECT_OUT_OF_BOUNDS 1u
#define REJECT_EMPTY_HISTORY 2u // stored depth is 0: sky or cleared history
#define REJECT_DEPTH_MISMATCH 3u

    bool depthMatches = planeDistance < Push.HistoryDepthRejectionThreshold;

    // why history was rejected, for the debug view (see post_processing.frag)
    uint rejectReason = REJECT_NONE;
    if (!prevUvInBounds) {
        rejectReason = REJECT_OUT_OF_BOUNDS;
    } else if (storedPrevDepth == 0.0) {
        rejectReason = REJECT_EMPTY_HISTORY;
    } else if (!depthMatches) {
        rejectReason = REJECT_DEPTH_MISMATCH;
    }

    bool validReprojection = rejectReason == REJECT_NONE;

    // temporal accumulation: running average capped at MaxSampleCount
    uint prevCount = validReprojection ? (imageLoad(RtgiReadSampleCount, prevPixel).r & SAMPLE_COUNT_MASK) : 0u;
    vec3 prevAccumulated = validReprojection ? imageLoad(RtgiReadHistory, prevPixel).rgb : vec3(0.0);
    vec3 accumulated = (prevAccumulated * float(prevCount) + newSample) / float(prevCount + 1u);

    imageStore(RtgiWriteHistory, pixel, vec4(accumulated, linearDepth));
    imageStore(RtgiWriteSampleCount, pixel, uvec4(min(prevCount + 1u, Push.MaxSampleCount) | (rejectReason << 16)));
    imageStore(IndirectLighting, pixel, vec4(accumulated, 1.0));
}
