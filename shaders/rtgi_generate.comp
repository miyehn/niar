#version 460 core
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

#include "rt_common.glsl"
#include "scene_common.glsl"
#include "sky_common.glsl"
#include "bindless_resources.glsl"
#include "cshared/lights.h"

// (set 0, binding 0) is view info from scene_common.glsl
layout(set = 0, binding = 1) uniform sampler2D SceneDepth;
layout(set = 0, binding = 2) uniform sampler2D GNormal;
layout(set = 0, binding = 3) uniform accelerationStructureEXT SceneTLAS;
layout(set = 0, binding = 4, rgba16f) uniform image2D IndirectLighting;
layout(set = 0, binding = 5) uniform sampler2D EnvironmentMap;
layout(set = 0, binding = 6, std430) readonly buffer SceneInstanceRecordTable {
    GpuSceneInstanceRecord SceneInstanceRecords[];
};
layout(set = 0, binding = 7) uniform RtgiPointLightsInfo {
    PointLightInfo Data[MAX_LIGHTS_PER_PASS];
} PointLights;
layout(set = 0, binding = 8) uniform RtgiDirectionalLightsInfo {
    DirectionalLightInfo Data[MAX_LIGHTS_PER_PASS];
} DirectionalLights;
layout(set = 0, binding = 9) uniform sampler2D RtgiReadHistory;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D RtgiWriteHistory;
layout(set = 0, binding = 11, r32ui) uniform uimage2D RtgiSampleCount;
layout(set = 0, binding = 12) uniform sampler2D MotionVectors;

#include "lighting_common.glsl"

layout(push_constant) uniform RtgiPushConstants {
    uint MaxSampleCount;
    float HistoryDepthRejectionThreshold;
} Push;

// (set 1, binding 0) sky parameters
// (set 1, binding 8) transmittance
// (set 1, binding 9) skyview

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

vec3 sampleBackground(ViewInfo viewInfo, vec3 rayDir)
{
    if (viewInfo.BackgroundOption == 1) {
        return sampleLongLatMap(EnvironmentMap, rayDir, 0.0);
    }
    if (viewInfo.BackgroundOption == 2) {
        return sampleSkyAtmosphere(rayDir);
    }
    return vec3(0.0);
}

vec3 shadeInvalid()
{
    return vec3(1, 0, 1) * 0.05;
}


vec3 shadeCommittedHit(RayHitResult hitResult, vec3 rayOrigin, vec3 rayDir)
{
    if (hitResult.instanceCustomIndex == ~0u) {
        return shadeInvalid();
    }

    GpuSceneInstanceRecord sceneInstance = SceneInstanceRecords[hitResult.instanceCustomIndex];

    HitSurface surface;
    if (!reconstructHitSurface(hitResult, sceneInstance, rayOrigin, rayDir, surface)) {
        return shadeInvalid();
    }

    vec3 albedo =
        sampleBindlessTexture2DLod(surface.material.textureIndices.x, surface.uv, 0.0).rgb *
        surface.material.baseColorFactor.rgb;
    vec3 emission =
        sampleBindlessTexture2DLod(surface.material.textureIndices.w, surface.uv, 0.0).rgb *
        surface.material.emissiveFactorAndClipThreshold.rgb;
    vec3 orm =
        sampleBindlessTexture2DLod(surface.material.textureIndices.z, surface.uv, 0.0).rgb *
        surface.material.ormAndNormalStrength.rgb;
    orm.g = clamp(orm.g, 0.04, 1.0); // roughness
    orm.b = clamp(orm.b, 0.0, 1.0); // metallic

    return emission + accumulateLighting(
        SceneTLAS,
        surface.worldPosition,
        surface.worldNormal,
        albedo,
        orm,
        surface.outgoingDirection);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(IndirectLighting);
    if (pixel.x >= dims.x || pixel.y >= dims.y) {
        return;
    }

    float deviceDepth = texelFetch(SceneDepth, pixel, 0).r;
    vec3 normal = texelFetch(GNormal, pixel, 0).xyz;
    if (deviceDepth >= 1.0f) {
        // sky pixel: no surface; clear history so it doesn't bleed when geometry moves in
        imageStore(IndirectLighting, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(RtgiWriteHistory, pixel, vec4(0.0));
        imageStore(RtgiSampleCount, pixel, uvec4(0u));
        return;
    }

    normal = normalize(normal);
    ViewInfo viewInfo = GetViewInfo();
    vec2 screenUv = (vec2(pixel) + 0.5f) / vec2(dims);
    vec3 worldPos = reconstructWorldPositionFromDepth(screenUv, deviceDepth, viewInfo);

    // linearized view-space depth, stored in history alpha for future rejection in chunk 5
    vec4 viewSpacePos = viewInfo.ViewMatrix * vec4(worldPos, 1.0);
    float linearDepth = -viewSpacePos.z;

    vec2 random = vec2(
        white_noise01(uvec3(uvec2(pixel), viewInfo.FrameIndex), viewInfo.FrameRandom.x),
        white_noise01(uvec3(uvec2(pixel.yx), viewInfo.FrameIndex), viewInfo.FrameRandom.y));
    vec3 rayDir = sampleCosineWeightedHemisphere(normal, random);
    vec3 rayOrigin = worldPos + normal * EPSILON;

    RayHitResult hitResult = traceRay(SceneTLAS, rayOrigin, rayDir, 0.001, 10000.0);
    vec3 newSample = hitResult.committed ? shadeCommittedHit(hitResult, rayOrigin, rayDir) : sampleBackground(viewInfo, rayDir);

    // read per-pixel motion vector (currentUV - prevUV) produced by the motion vector pass
    vec2 motionVector = texture(MotionVectors, screenUv).rg;
    vec2 prevUv = screenUv - motionVector;
    float expectedPrevDepth = -(viewInfo.PrevViewMatrix * vec4(worldPos, 1.0)).z;
    float storedPrevDepth = texture(RtgiReadHistory, prevUv).a;
    bool validReprojection = all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0)))
        && abs(storedPrevDepth - expectedPrevDepth) < Push.HistoryDepthRejectionThreshold;

    // temporal accumulation: running average capped at MaxSampleCount
    ivec2 prevPixel = ivec2(prevUv * vec2(dims));
    uint prevCount = validReprojection ? imageLoad(RtgiSampleCount, prevPixel).r : 0u;
    vec3 prevAccumulated = validReprojection ? texture(RtgiReadHistory, prevUv).rgb : vec3(0.0);
    vec3 accumulated = (prevAccumulated * float(prevCount) + newSample) / float(prevCount + 1u);

    imageStore(RtgiWriteHistory, pixel, vec4(accumulated, linearDepth));
    imageStore(RtgiSampleCount, pixel, uvec4(min(prevCount + 1u, Push.MaxSampleCount)));
    imageStore(IndirectLighting, pixel, vec4(accumulated, 1.0));
}
