#version 450

layout(set = 1, binding = 0) uniform sampler2D SceneColor;
layout(set = 1, binding = 1) uniform sampler2D TaaReadHistory;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D TaaResolved;
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2D TaaWriteHistory;
layout(set = 1, binding = 4) uniform sampler2D MotionVectors;

layout(push_constant) uniform TaaPushConstants {
    float HistoryWeight;
    float ClampExpansion;
    uint Enabled;
} Push;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(TaaResolved);
    if (pixel.x >= dims.x || pixel.y >= dims.y) {
        return;
    }

    vec3 currentColor = texelFetch(SceneColor, pixel, 0).rgb;

    vec3 resolved;
    if (Push.Enabled == 0u) {
        // TAA disabled: no jitter was applied upstream either, so this is already the plain
        // image. Still write it through to both outputs so history stays warm with real scene
        // data instead of cold-starting from black if TAA gets re-enabled later.
        resolved = currentColor;
    } else {
        // build a local color AABB from the current frame's 3x3 neighborhood, so stale history
        // that no longer matches what's actually here now gets pulled back into a plausible range
        // instead of visibly ghosting
        vec3 neighborMin = currentColor;
        vec3 neighborMax = currentColor;
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == 0 && dy == 0) {
                    continue;
                }
                ivec2 neighborPixel = clamp(pixel + ivec2(dx, dy), ivec2(0), dims - 1);
                vec3 neighborColor = texelFetch(SceneColor, neighborPixel, 0).rgb;
                neighborMin = min(neighborMin, neighborColor);
                neighborMax = max(neighborMax, neighborColor);
            }
        }
        // widen the box so clamping doesn't over-tighten on thin/high-frequency detail (e.g.
        // lattice screens, mullions) where the raw min/max box would otherwise be nearly a point
        vec3 boxCenter = (neighborMin + neighborMax) * 0.5;
        vec3 boxExtent = (neighborMax - neighborMin) * 0.5 * (1.0 + Push.ClampExpansion);
        neighborMin = boxCenter - boxExtent;
        neighborMax = boxCenter + boxExtent;

        // reproject to where this pixel's surface was last frame, using the G-buffer motion
        // vector (currentUV - prevUV), same convention as rtgi_generate.comp
        vec2 screenUv = (vec2(pixel) + 0.5f) / vec2(dims);
        vec2 motionVector = texture(MotionVectors, screenUv).rg;
        vec2 prevUv = screenUv - motionVector;
        bool validReprojection = all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0)));

        if (validReprojection) {
            // bilinear: prevUv is a reprojected fractional position, not a texel center
            vec3 historyColor = texture(TaaReadHistory, prevUv).rgb;
            vec3 clampedHistory = clamp(historyColor, neighborMin, neighborMax);
            resolved = mix(currentColor, clampedHistory, Push.HistoryWeight);
        } else {
            // surface wasn't visible last frame (offscreen or newly revealed): no history to blend
            resolved = currentColor;
        }
    }

    imageStore(TaaResolved, pixel, vec4(resolved, 1.0));
    imageStore(TaaWriteHistory, pixel, vec4(resolved, 1.0));
}
